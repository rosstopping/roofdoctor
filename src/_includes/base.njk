<!doctype html>
<html lang="en-GB" class="scroll-smooth">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description or site.description }}">
  <meta name="theme-color" content="#1f2937">
  <title>{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}</title>
  {% set absolutePageUrl = page.url %}
  {% if site.url %}{% set absolutePageUrl = site.url + page.url %}{% endif %}
  {% set absoluteOgImage = site.ogImage %}
  {% if site.url and site.ogImage %}{% set absoluteOgImage = site.url + site.ogImage %}{% endif %}
  {% if site.url %}<link rel="canonical" href="{{ absolutePageUrl }}">{% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ title }}{% if title != site.name %} | {{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description or site.description }}">
  {% if site.url %}<meta property="og:url" content="{{ absolutePageUrl }}">{% endif %}
  {% if absoluteOgImage %}<meta property="og:image" content="{{ absoluteOgImage }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "RoofingContractor",
      "name": {{ site.name | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "areaServed": {{ site.areas | dump | safe }},
      "serviceType": ["Roof repairs", "New roofs", "Domestic roofing", "Commercial roofing"]{% if site.url %},
      "url": {{ absolutePageUrl | dump | safe }}{% endif %}
    }
  </script>
</head>
<body class="bg-stone-100 font-sans text-slate-900 antialiased">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-slate-950">Skip to content</a>
  {% include "partials/header.njk" %}
  <main id="main-content">{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
  <div class="sticky bottom-0 z-30 border-t border-slate-900 bg-white/95 px-4 py-3 shadow-[0_-8px_24px_rgba(15,23,42,0.08)] backdrop-blur sm:hidden">
    <a href="/contact/" class="flex items-center justify-center bg-amber-500 px-4 py-3 text-sm font-bold uppercase tracking-[0.18em] text-slate-950 motion-safe:transition hover:bg-amber-400 motion-reduce:transition-none">Request a quote</a>
  </div>
</body>
</html>
