<footer class="border-t border-slate-900 bg-slate-950 text-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.4fr_0.8fr] lg:px-8">
    <div>
      <p class="text-lg font-bold uppercase tracking-[0.08em]">{{ site.name }}</p>
      <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">{{ site.footerBlurb }}</p>
    </div>
    <div class="grid gap-2 text-sm text-slate-300">
      <p class="font-semibold uppercase tracking-[0.14em] text-white">Pages</p>
      {% for item in site.navigation %}
        <a href="{{ item.url }}" class="w-fit hover:text-amber-300">{{ item.label }}</a>
      {% endfor %}
    </div>
  </div>
</footer>
