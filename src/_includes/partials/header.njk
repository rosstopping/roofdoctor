<header class="border-b border-slate-900/10 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <a href="/" class="inline-flex items-center gap-3 text-slate-950">
        <span class="grid h-10 w-10 place-items-center bg-slate-900 text-xs font-black uppercase tracking-[0.2em] text-white">RD</span>
        <span>
          <span class="block text-lg font-bold uppercase tracking-[0.08em]">{{ site.name }}</span>
          <span class="block text-sm text-slate-600">Doncaster roofing contractors</span>
        </span>
      </a>
      <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm font-semibold uppercase tracking-[0.14em]">
        {% for item in site.navigation %}
          <a href="{{ item.url }}" class="border-b-2 pb-1 motion-safe:transition hover:border-amber-500 hover:text-slate-950 motion-reduce:transition-none {% if page.url == item.url %}border-slate-950 text-slate-950{% else %}border-transparent text-slate-600{% endif %}">{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </div>
</header>
